# Firebase Web config (copy from Firebase Console > Project settings > Your apps > Web app)
# These VITE_* values are public client config; never put admin credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=fitai-7dc19
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only secrets (never prefix these with VITE_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Paste the complete Firebase Admin service-account JSON as one compact JSON line.
FIREBASE_SERVICE_ACCOUNT={}
PORT=10000
