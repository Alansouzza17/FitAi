# Use o endereço público do serviço FitIA no Render ao hospedar o frontend na Vercel.
# Em Render/local com npm start, deixe vazio para usar a mesma origem.
VITE_API_BASE_URL=

# Segredos apenas no backend do Render (nunca use prefixo VITE_).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Allowed frontend origins when Vercel calls the Render API. Leave empty for same-origin Render hosting.
CORS_ORIGINS=https://fitai-eight-sigma.vercel.app
PORT=10000
